# Token do bot (Portal do Desenvolvedor > Bot > Reset Token)
DISCORD_TOKEN=

# Application ID (Portal do Desenvolvedor > General Information > Application ID)
DISCORD_CLIENT_ID=

# Opcional: ID do servidor para registrar slash commands instantaneamente.
# Sem este valor, os comandos são globais e podem levar até 1 hora para aparecer.
DISCORD_GUILD_ID=

# Provedor de IA compatível com a API Chat Completions da OpenAI
# (OpenAI, Groq, OpenRouter, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Opcional
# LOG_LEVEL=info
# SYSTEM_PROMPT=Você é um assistente útil no Discord. Responda de forma clara e objetiva.
# MAX_HISTORY_MESSAGES=20
# USER_COOLDOWN_MS=3000

# MySQL (o bot cria o database se ele ainda não existir)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=discord_bot_ia
